---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import LatestWriteups from '../../components/LatestWriteups.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writeups');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const siteUrl = Astro.site!.toString();
const postUrl = new URL(`/blogs/${post.slug}`, siteUrl).toString();
const postRobots = post.data.unlisted ? 'noindex, follow' : 'index, follow';

const blogPostingLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
  "image": post.data.image ? [post.data.image.startsWith('http') ? post.data.image : new URL(post.data.image, siteUrl).toString()] : [],
  "url": postUrl,
  "datePublished": post.data.date.toISOString(),
  ...(post.data.dateModified && { dateModified: post.data.dateModified.toISOString() }),
  "author": {
    "@type": "Person",
    "name": "Debmalya Mondal",
    "url": siteUrl,
    "sameAs": [
      "https://x.com/d3vdebug",
      "https://github.com/d3vdebug"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "devdebug",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/og-page.png", siteUrl).toString()
    }
  },
  "keywords": post.data.tags ? post.data.tags.join(', ') : ''
});

// Toggle dates visibility here
const SHOW_DATES = false;
---

<Layout title={post.data.title} description={post.data.description} image={post.data.image} url={`/blogs/${post.slug}`} robots={postRobots} breadcrumbs={[{ name: 'Home', item: siteUrl }, { name: 'Blogs', item: new URL('/blogs', siteUrl).toString() }, { name: post.data.title, item: postUrl }]}>
  <script type="application/ld+json" set:html={blogPostingLd} />
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-[1fr_280px] gap-12">
      <article class="w-full min-w-0">
        <Breadcrumbs title={post.data.title} category={post.data.category} />

        <div class="bg-gray-900/40 rounded-none md:rounded-sm overflow-hidden p-4 sm:p-5 md:p-6 mt-4 md:border md:border-gray-700">
        {post.data.image && (
          <div class="aspect-video w-full overflow-hidden rounded-md bg-gray-800 mb-4 sm:mb-6">
            <img 
              src={post.data.image} 
              alt={post.data.title}
              width="1200"
              height="630"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover opacity-90 rounded-md"
            />
          </div>
        )}

        <div class="flex items-center justify-between gap-3 text-sm text-gray-500 mb-6 sm:mb-8">
          <span>By <span class="text-gray-400">Debmalya Mondal</span></span>
          <span id="read-time">Calculating...</span>
        </div>

        <header class="mb-8 sm:mb-10 pb-6 sm:pb-8 border-b border-gray-800">
          {SHOW_DATES && (
            <div class="flex items-center gap-3 text-sm text-gray-500 mb-4">
              <span class="text-green-400 font-medium">{post.data.category}</span>
              <span>•</span>
              <time>{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
              {post.data.platform && (
                <>
                  <span>•</span>
                  <span class="text-gray-400">{post.data.platform}</span>
                </>
              )}
            </div>
          )}
          
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-gray-100 mb-3 sm:mb-4 tracking-tight break-words">
            {post.data.title}
          </h1>
          
          <p class="text-base sm:text-lg text-gray-400 leading-relaxed break-words">
            {post.data.description}
          </p>
          <div class="flex items-center justify-between gap-3 mt-4">
            {post.data.difficulty && (
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border ${
                post.data.difficulty === 'Easy' ? 'text-green-400 bg-green-400/10 border-green-400/20' :
                post.data.difficulty === 'Medium' ? 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20' :
                post.data.difficulty === 'Hard' ? 'text-red-400 bg-red-400/10 border-red-400/20' :
                'text-purple-400 bg-purple-400/10 border-purple-400/20'
              }`}>
                <i class="ph ph-chart-bar text-sm"></i>
                <span class="text-xs font-medium">{post.data.difficulty}</span>
              </span>
            )}
            <button id="share-btn" class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-green-400 transition-colors border border-gray-800 hover:border-green-500/40 rounded-md px-2.5 py-1" title="Copy link">
              <i class="ph ph-link text-sm"></i>
              <span>Share</span>
            </button>
          </div>
        </header>
        
        <div class="prose prose-invert prose-green max-w-none">
          <Content />
        </div>

        <div class="flex flex-wrap gap-2 mt-8">
          {post.data.tags.map(tag => (
            <span class="text-xs px-2.5 py-1 bg-gray-800 text-gray-400 rounded-md">
              #{tag}
            </span>
          ))}
        </div>
        </div>
      </article>
      
      <aside class="hidden lg:block">
        <div class="sticky top-24 margin-righ">
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4 toc-heading">Contents</h3>
          <nav id="toc" class="space-y-1 text-sm">
            <!-- TOC injected by JS -->
          </nav>
        </div>
      </aside>
    </div>
    
    <div class="h-16"></div>
    
    <LatestWriteups currentSlug={post.slug} />
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const contentDiv = document.querySelector('.prose') as HTMLElement | null;
      const toc = document.getElementById('toc') as HTMLElement | null;
      if (!contentDiv || !toc) return;

      const headings = contentDiv.querySelectorAll('h1, h2, h3') as NodeListOf<HTMLElement>;
      const tocItems: Array<{ link: HTMLAnchorElement; id: string; isH3: boolean }> = [];

      headings.forEach((heading, index) => {
        if (!heading.id) heading.id = `section-${index}`;

        const link = document.createElement('a') as HTMLAnchorElement;
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || '';
        const isH3 = heading.tagName === 'H3';

        link.className = `block py-1.5 transition-colors ${isH3 ? 'pl-5 text-xs text-gray-500' : 'pl-3 text-gray-400'}`;
        link.dataset.level = isH3 ? '3' : '2';

        toc.appendChild(link);
        tocItems.push({ link, id: heading.id, isH3 });
      });

      const setActive = (id?: string) => {
        tocItems.forEach(item => {
          const isActive = item.id === id;
          const isH3 = item.isH3;

          // base classes for spacing/size
          item.link.className = isH3 ? 'block py-1.5 transition-colors pl-5 text-xs' : 'block py-1.5 transition-colors pl-3';

          // apply visible inline styles so highlight works even when Tailwind classes are missing
          if (isActive) {
            // active color (green) and stronger weight for top-level
            item.link.style.color = '#4ade80'; // tailwind green-400
            if (!isH3) item.link.style.fontWeight = '600';
            item.link.textContent = `> ${item.link.textContent.replace(/^> /, '')}`;
          } else {
            // inactive colors: slightly muted for h3, neutral for top-level
            item.link.style.color = isH3 ? '#9ca3af' : '#9ca3af';
            item.link.style.fontWeight = isH3 ? '400' : '400';
            item.link.textContent = item.link.textContent.replace(/^> /, '');
          }
        });
      };

      const onScroll = () => {
        if (suppressScrollUpdate) return;

        const scrollMiddle = window.scrollY + (window.innerHeight / 2);
        let current = tocItems[0]?.id;

        for (let i = tocItems.length - 1; i >= 0; i--) {
          const heading = document.getElementById(tocItems[i].id) as HTMLElement | null;
          if (heading) {
            const rect = heading.getBoundingClientRect();
            const absoluteTop = rect.top + window.scrollY;
            if (absoluteTop <= scrollMiddle) {
              current = tocItems[i].id;
              break;
            }
          }
        }

        const docHeight = document.documentElement.scrollHeight;
        const scrollBottom = window.scrollY + window.innerHeight;
        if (docHeight - scrollBottom < 100 && tocItems.length > 0) {
          current = tocItems[tocItems.length - 1].id;
        }

        setActive(current);
      };

      let suppressScrollUpdate = false;

      tocItems.forEach(item => {
        item.link.addEventListener('click', (e: Event) => {
          e.preventDefault();
          suppressScrollUpdate = true;
          setActive(item.id);

          const heading = document.getElementById(item.id) as HTMLElement | null;
          if (heading) heading.scrollIntoView({ behavior: 'smooth', block: 'start' });

          setTimeout(() => {
            suppressScrollUpdate = false;
            onScroll();
          }, 800);
        });
      });

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      onScroll();

      calculateReadTime();

      const shareBtn = document.getElementById('share-btn');
      if (shareBtn) {
        shareBtn.addEventListener('click', async () => {
          const url = window.location.href;
          try {
            await navigator.clipboard.writeText(url);
            const originalHTML = shareBtn.innerHTML;
            shareBtn.innerHTML = '<i class="ph ph-check text-sm"></i><span>Copied</span>';
            shareBtn.classList.add('text-green-400', 'border-green-500/40');
            setTimeout(() => {
              shareBtn.innerHTML = originalHTML;
              shareBtn.classList.remove('text-green-400', 'border-green-500/40');
            }, 2000);
          } catch {
            shareBtn.innerHTML = '<i class="ph ph-warning text-sm"></i><span>Failed</span>';
          }
        });
      }
    });
    
    function calculateReadTime() {
      const prose = document.querySelector('.prose');
      const readTimeEl = document.getElementById('read-time');
      if (!prose || !readTimeEl) return;
      
      const text = prose.textContent || '';
      const words = text.trim().split(/\s+/).filter(w => w.length > 0);
      const wordCount = words.length;
      const readTime = Math.max(1, Math.ceil(wordCount / 200));
      readTimeEl.textContent = `${readTime} min read`;
    }

      // Fix for inline code showing literal backticks: strip leading/trailing backticks,
      // whitespace, and zero-width chars. Skip block code (`pre > code`).
      (function stripVisibleBackticks() {
        const codes = document.querySelectorAll('.prose code');
        codes.forEach(code => {
          if (code.closest('pre')) return; // skip code blocks
          const txt = code.textContent || '';
          const fixed = txt.replace(/^[\s\u200B`]+|[\s\u200B`]+$/g, '');
          if (fixed !== txt) code.textContent = fixed;
        });
      })();

      // Add terminal-style window headers to code blocks
      (function addCodeLanguageLabels() {
        const content = document.querySelector('.prose');
        if (!content) return;

        content.querySelectorAll('pre').forEach(pre => {
          const lang = pre.getAttribute('data-language');
          if (!lang) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';

          const header = document.createElement('div');
          header.className = 'code-header';

          const label = document.createElement('span');
          label.className = 'code-lang';
          label.textContent = lang;

          const copyBtn = document.createElement('button');
          copyBtn.className = 'code-copy-btn';
          copyBtn.textContent = 'Copy';
          copyBtn.setAttribute('aria-label', 'Copy code');

          const code = pre.querySelector('code');
          const codeText = code ? code.textContent || '' : '';

          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(codeText);
              copyBtn.textContent = 'Copied!';
              setTimeout(() => {
                copyBtn.textContent = 'Copy';
              }, 2000);
            } catch {
              copyBtn.textContent = 'Failed';
              setTimeout(() => {
                copyBtn.textContent = 'Copy';
              }, 2000);
            }
          });

          header.appendChild(label);
          header.appendChild(copyBtn);
          wrapper.appendChild(header);
          const parent = pre.parentNode;
          if (!parent) return;
          parent.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);
        });
      })();
    
    // Image captions + lightbox
    (function enhanceArticleImages() {
      document.addEventListener('DOMContentLoaded', () => {
        const content = document.querySelector('.prose');
        if (!content) return;

        // Create lightbox elements
        const overlay = document.createElement('div');
        overlay.className = 'fixed inset-0 bg-black/80 hidden flex items-center justify-center z-50 p-4';
        overlay.style.backdropFilter = 'blur(6px)';

        const modal = document.createElement('div');
        modal.className = 'max-w-[90%] max-h-[90%] overflow-hidden rounded-none';

        const modalImg = document.createElement('img');
        modalImg.className = 'w-full h-auto block rounded-none';
        modalImg.alt = '';
        modalImg.style.borderRadius = '0';

        const modalCaption = document.createElement('div');
        modalCaption.className = 'mt-2 text-sm text-gray-300 text-center';

        const closeBtn = document.createElement('button');
        closeBtn.className = 'absolute top-3 right-3 text-white text-2xl bg-black/50 hover:bg-black/70 rounded-full w-9 h-9 flex items-center justify-center';
        closeBtn.setAttribute('aria-label', 'Close image');
        closeBtn.innerHTML = '&times;';
        // remove the green focus outline applied globally; keep accessibility by managing focus styles here
        closeBtn.style.outline = 'none';
        closeBtn.style.boxShadow = 'none';
        closeBtn.style.border = 'none';
        // ensure the close button sits above modal content
        closeBtn.style.zIndex = '10001';

        const wrapper = document.createElement('div');
        wrapper.className = 'relative';
        wrapper.appendChild(modalImg);
        wrapper.appendChild(closeBtn);

        modal.appendChild(wrapper);
        modal.appendChild(modalCaption);
        overlay.appendChild(modal);
        document.body.appendChild(overlay);

        function openLightbox(src: string, caption: string | null) {
          modalImg.src = src;
          modalImg.alt = caption || '';
          modalCaption.textContent = caption || '';
          overlay.classList.remove('hidden');
          document.documentElement.style.overflow = 'hidden';

          // ensure modal is centered and close button is visible on open
          setTimeout(() => {
            overlay.scrollIntoView({ block: 'center', behavior: 'auto' });
            // focus close button for accessibility
            closeBtn.focus();
          }, 30);
        }

        function closeLightbox(): void {
          overlay.classList.add('hidden');
          modalImg.src = '';
          modalCaption.textContent = '';
          document.documentElement.style.overflow = '';
        }

        closeBtn.addEventListener('click', closeLightbox);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeLightbox();
        });

        const imgs = content.querySelectorAll('img');
        imgs.forEach(img => {
          // determine caption: prefer data-caption, then title, then alt
          const caption = img.getAttribute('data-caption') || img.getAttribute('title') || img.getAttribute('alt') || '';

          // wrap in figure
          const figure = document.createElement('figure');
          figure.className = 'group flex flex-col items-center gap-0';

          const imgWrapper = document.createElement('div');
          imgWrapper.className = 'cursor-zoom-in overflow-hidden rounded-md mx-auto';
          imgWrapper.style.display = 'inline-block';

          // move img into wrapper
          const parent = img.parentNode;
          if (!parent) return;
          parent.replaceChild(figure, img);
          imgWrapper.appendChild(img);
          figure.appendChild(imgWrapper);

          if (caption) {
            const captionSize = img.getAttribute('data-caption-size') || '';
            const sizeMap: Record<string,string> = { xs: 'text-xs', sm: 'text-sm', md: 'text-base', lg: 'text-lg', xl: 'text-xl' };
            const figcap = document.createElement('figcaption');
            const sizeClass = sizeMap[captionSize] || 'text-sm';
            figcap.className = `mt-0 ${sizeClass} text-gray-400 text-center`;
            figcap.style.maxWidth = '85%';
            figcap.style.marginTop = '-6px';
            figcap.style.lineHeight = '1';
            if (captionSize && captionSize.endsWith('px')) {
              figcap.style.fontSize = captionSize;
            }
            figcap.textContent = caption;
            figure.appendChild(figcap);
          }

          img.style.cursor = 'zoom-in';
          img.addEventListener('click', () => openLightbox(img.src, caption));
        });
      });
    })();
  </script>
</Layout>
