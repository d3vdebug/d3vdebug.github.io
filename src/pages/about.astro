---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About DevDebug — security researcher documenting web exploitation, reverse engineering, active directory attacks, and CTF writeups." url="/about">
  <div class="max-w-2xl mx-auto space-y-6">
    <div class="border border-gray-800 bg-gray-900/40 rounded-2xl p-8">
      <div class="flex flex-col items-center text-center">
        <div class="w-32 h-32 rounded-xl bg-gray-800 border border-gray-700 flex items-center justify-center text-gray-400 text-xl font-semibold mb-4 overflow-hidden">
          <img src="/profile.png" alt="DevDebug profile" class="w-full h-full object-cover" />
        </div>
        
        <h1 class="text-2xl font-semibold text-gray-100 mb-1">DevDebug</h1>
        <p class="text-gray-400 text-sm mb-4">Security Researcher | CTF Player</p>
        
        <p class="text-gray-300 leading-relaxed max-w-md">
          Security researcher focused on web application security, active directory attacks, and reverse engineering.
        </p>
      </div>
    </div>
    
    <div class="border border-gray-800 bg-gray-900/40 rounded-2xl p-8">
      <h2 class="text-lg font-semibold text-gray-100 mb-6 text-center">Connect with me</h2>
      
      <div class="grid grid-cols-2 gap-3">
        <a href="https://github.com/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          GitHub
        </a>
        <a href="https://twitter.com/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
          </svg>
          Twitter
        </a>
        <a href="https://www.linkedin.com/in/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          LinkedIn
        </a>
        <a href="https://medium.com/@d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          Medium
        </a>
      </div>
    </div>
  </div>
</Layout>
