---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('writeups'))
  .filter(post => !post.data.unlisted)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const postsData = allPosts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString(),
  tags: post.data.tags,
  category: post.data.category,
  difficulty: post.data.difficulty,
  image: post.data.image
}));
---

<Layout title="DevDebug" description="Cybersecurity research, CTF writeups, and technical walkthroughs by devdebug." url="/" image="/og-page.png">
  <section class="mb-20 py-12 md:py-20 px-4 sm:px-0">
    <div class="text-center max-w-3xl mx-auto">

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-gray-100 mb-4 leading-tight tracking-tight">
        Debmalya Mondal
        <br /><span class="text-green-400 text-[40px]">Security Researcher & Threat Hunter</span>
      </h1>

     

      <p class="text-gray-400 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
       Documenting my learning on security research. Web exploitation, Cryptography, and Red Team operations.
      </p>

      <div class="flex items-center gap-4 justify-center">
        <a href="/categories" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-700 text-gray-300 px-5 py-3 rounded-lg text-sm font-medium transition-colors">
          Browse Categories
        </a>
        <a href="/blogs" class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-gray-950 px-5 py-3 rounded-lg text-sm font-semibold shadow-sm transition-transform transform hover:-translate-y-0.5">
          Read Blogs
          <i class="ph ph-arrow-right text-base"></i>
        </a>
      </div>

      <div class="mt-8 flex items-center justify-center gap-3">
        <a href="https://github.com/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <i class="ph-fill ph-github-logo"></i>
          GitHub
        </a>
        <a href="https://twitter.com/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <i class="ph-fill ph-x-logo"></i>
          Twitter
        </a>
        <a href="https://www.linkedin.com/in/devdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <i class="ph-fill ph-linkedin-logo"></i>
          LinkedIn
        </a>
        <a href="https://medium.com/@devdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <i class="ph-fill ph-medium-logo"></i>
          Medium
        </a>
      </div>
    </div>
  </section>

  <section>
    <div class="flex flex-col gap-3 mb-8 items-center sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-xl font-semibold text-gray-100">Latest Blogs</h2>
      <a href="/blogs" class="text-sm text-gray-400 hover:text-green-400 transition-colors">View all →</a>
    </div>

    <div id="posts-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {postsData.map(post => (
        <PostCard post={post} />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/blogs" class="inline-block border border-gray-800 px-6 py-3 rounded-lg text-gray-300 hover:border-green-500/50 hover:text-green-400 transition-colors">View More</a>
    </div>
  </section>
</Layout>
