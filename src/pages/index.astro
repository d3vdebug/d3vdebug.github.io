---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('writeups'))
  .filter(post => !post.data.unlisted)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const postsData = allPosts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString(),
  tags: post.data.tags,
  category: post.data.category,
  difficulty: post.data.difficulty,
  image: post.data.image
}));
---

<Layout title="DevDebug" description="Cybersecurity research, CTF writeups, and technical walkthroughs by devdebug." url="/" image="/og-page.png">
  <section class="mb-20 py-20">
    <div class="text-center max-w-3xl mx-auto">

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-gray-100 mb-4 leading-tight tracking-tight">
        Debmalya Mondal
        <br /><span class="text-green-400 text-[40px]">Security Researcher & Threat Hunter</span>
      </h1>

      <div class="mx-auto w-50 h-0.5 rounded-full bg-gradient-to-r from-green-400/30 to-green-400/10 mb-6"></div>

      <p class="text-gray-400 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
       Documenting my learning on security research. Web exploitation, Cryptography, and Red Team operations.
      </p>

      <div class="flex items-center gap-4 justify-center">
        <a href="/blogs" class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-gray-950 px-5 py-3 rounded-lg text-sm font-semibold shadow-sm transition-transform transform hover:-translate-y-0.5">
          Read Blogs
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/categories" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-700 text-gray-300 px-5 py-3 rounded-lg text-sm font-medium transition-colors">
          Browse Categories
        </a>
      </div>

      <div class="mt-8 flex items-center justify-center gap-3">
        <a href="https://github.com/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <!-- GitHub icon kept as-is -->
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          GitHub
        </a>
        <a href="https://twitter.com/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
          </svg>
          Twitter
        </a>
        <a href="https://www.linkedin.com/in/d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          LinkedIn
        </a>
        <a href="https://medium.com/@d3vdebug" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-gray-800 hover:border-gray-600 text-gray-300 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          Medium
        </a>
      </div>
    </div>
  </section>

  <section>
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl font-semibold text-gray-100">Latest Blogs</h2>
      <a href="/blogs" class="text-sm text-gray-400 hover:text-green-400 transition-colors">View all →</a>
    </div>

    <div id="posts-grid" class="grid md:grid-cols-3 gap-6">
      {postsData.map(post => (
        <PostCard post={post} />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/blogs" class="inline-block border border-gray-800 px-6 py-3 rounded-lg text-gray-300 hover:border-green-500/50 hover:text-green-400 transition-colors">View More</a>
    </div>
  </section>
</Layout>
