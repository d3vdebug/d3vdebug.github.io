---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Not Found" robots="noindex, follow" breadcrumbs={[{ name: 'Home', item: `${Astro.site}/` }]}>
  <div class="max-w-3xl mx-auto text-center py-20">
    <h1 class="text-5xl font-semibold text-green-400 mb-4">404</h1>
    <p class="text-gray-400 text-lg mb-8">Page not found. The exploit didn't work.</p>
    <a href="/" class="inline-block border border-gray-800 px-6 py-3 rounded-lg text-gray-300 hover:border-green-500/50 hover:text-green-400 transition-colors">
      Return to Base
    </a>
  </div>
</Layout>
