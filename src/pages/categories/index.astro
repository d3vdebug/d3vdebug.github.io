---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('writeups')).filter(post => !post.data.unlisted);

const categoryCounts = allPosts.reduce((acc, post) => {
  acc[post.data.category] = (acc[post.data.category] || 0) + 1;
  return acc;
}, {});

const sortedCategories = Object.entries(categoryCounts)
  .sort((a, b) => b[1] - a[1]);

const latestByCategory = {};
allPosts.forEach(post => {
  if (!latestByCategory[post.data.category]) {
    latestByCategory[post.data.category] = post.data;
  }
});
---

<Layout title="Categories" description="Browse all cybersecurity writeups by category — HackTheBox, TryHackMe, picoCTF, OverTheWire, and more." url="/categories">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <h1 class="text-3xl font-semibold text-gray-100 mb-2 tracking-tight">Categories</h1>
      <p class="text-gray-400">Browse all blog categories.</p>
    </div>
    
    <div class="space-y-3">
      {sortedCategories.map(([category, count]) => (
        <a href={`/categories/${category}`} class="block border border-gray-800 bg-gray-900/30 rounded-xl p-6 hover:border-green-500/50 hover:bg-gray-900/50 transition-all group">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg bg-gray-800 flex items-center justify-center text-gray-400 group-hover:text-green-400 group-hover:bg-green-400/10 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-semibold text-gray-100 group-hover:text-green-400 transition-colors">
                  {category}
                </h2>
                <p class="text-sm text-gray-500">
                  {count} {count === 1 ? 'post' : 'posts'}
                </p>
              </div>
            </div>
            
            <div class="flex items-center gap-2 text-gray-500 group-hover:text-green-400 transition-colors">
              <span class="text-xs font-medium uppercase tracking-wider">View</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
