---
interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  robots?: string;
  breadcrumbs?: { name: string; item: string }[];
}

const { 
  title, 
  description = 'Detailed cybersecurity writeups, CTF challenge walkthroughs, tool guides, and vulnerability analysis by devdebug.', 
  image = '/og-page.png', 
  url = Astro.url.pathname, 
  robots = 'index, follow',
  breadcrumbs = [
    { name: 'Home', item: `${Astro.site}/` }
  ]
} = Astro.props;

import '../styles/global.css';

const siteUrl = Astro.site!.toString();

const absoluteUrl = (path: string) => new URL(path, siteUrl).toString();

const websiteLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "devdebug",
  "url": siteUrl,
  "description": "Detailed cybersecurity writeups, CTF challenge walkthroughs, tool guides, and vulnerability analysis by devdebug.",
  "author": {
    "@type": "Person",
    "name": "Debmalya Mondal",
    "url": siteUrl,
    "sameAs": [
      "https://x.com/d3vdebug",
      "https://github.com/d3vdebug"
    ]
  }
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.name,
    "item": crumb.item
  }))
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={absoluteUrl(url)} />
    <meta name="robots" content={robots} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={absoluteUrl(url)} />
    <meta property="og:title" content={title.toLowerCase() === 'devdebug' ? 'devdebug' : `${title} // devdebug`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : absoluteUrl(image)} />
    <meta property="og:site_name" content="devdebug" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={absoluteUrl(url)} />
    <meta property="twitter:title" content={title.toLowerCase() === 'devdebug' ? 'devdebug' : `${title} // devdebug`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image.startsWith('http') ? image : absoluteUrl(image)} />
    <meta property="twitter:site" content="@d3vdebug" />
    <meta property="twitter:creator" content="@d3vdebug" />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={websiteLd} />
    
    <script type="application/ld+json" set:html={breadcrumbLd} />
    
    <title>{title.toLowerCase() === 'devdebug' ? 'devdebug' : `${title} // devdebug`}</title>
    
    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
    <script>
      (window as any).dataLayer = (window as any).dataLayer || [];
      function gtag(...args: any[]) { (window as any).dataLayer.push(args); }
      gtag('js', new Date());
      gtag('config', import.meta.env.PUBLIC_GA_ID);
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen antialiased flex flex-col">
    <header class="border-b border-gray-800 bg-gray-950/80 backdrop-blur-md sticky top-0 z-50 w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 md:py-4 flex items-center justify-between gap-3 md:gap-4 relative w-full">
        <a href="/" class="text-lg font-semibold text-gray-100 hover:text-green-400 transition-colors whitespace-nowrap flex-shrink-0">
          devdebug
        </a>
        
        <div class="hidden md:block w-80 md:w-[420px] mx-4 min-w-0">
          <div class="relative">
             <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-base"></i>
             <input 
               type="search" 
               id="nav-search"
               placeholder="Search..." 
               aria-label="Search"
               class="w-full bg-gray-900 border border-gray-800 rounded-lg pl-10 pr-4 py-2 text-sm text-gray-300 placeholder-gray-500 focus:outline-none focus:border-green-500/50 focus:ring-1 focus:ring-green-500/50 transition-colors"
             />
          </div>
        </div>
        
        <button id="mobile-menu-toggle" class="md:hidden ml-auto inline-flex items-center p-2 rounded-md text-gray-400 hover:text-gray-100 hover:bg-gray-900/20" aria-expanded="false" aria-controls="mobile-menu">
          <i class="ph ph-list text-gray-400 text-xl"></i>
        </button>

        <nav class="hidden md:flex flex-1 items-center justify-end text-sm text-gray-400 flex-shrink-0">
          <div id="nav-links" class="hidden md:flex items-center space-x-0">
            <a href="/" class="hover:text-gray-100 transition-colors inline-flex items-center gap-2 px-2 py-2">
              <i class="ph-fill ph-house"></i>
              Home
            </a>
            <a href="/blogs" class="hover:text-gray-100 transition-colors inline-flex items-center gap-2 px-2 py-2">
              <i class="ph-fill ph-newspaper"></i>
              Blogs
            </a>
            <a href="/categories" class="hover:text-gray-100 transition-colors inline-flex items-center gap-2 px-2 py-2">
              <i class="ph-fill ph-folder-simple-minus"></i>
              Categories
            </a>
            <a href="/tags" class="hover:text-gray-100 transition-colors inline-flex items-center gap-2 px-2 py-2">
              <i class="ph-fill ph-tag"></i>
              Tags
            </a>
            <a href="/about" class="hover:text-gray-100 transition-colors inline-flex items-center gap-2 px-2 py-2">
              <i class="ph-fill ph-user"></i>
              About
            </a>
          </div>
        </nav>

        <!-- Mobile menu (hidden by default) -->
        <div id="mobile-menu" class="md:hidden hidden absolute right-4 top-full mt-2 w-56 bg-gray-900 border border-gray-800 rounded-md py-2 z-50 shadow-lg shadow-black/30">
          <a href="/" class="block px-4 py-2 text-sm text-gray-200 hover:bg-gray-800">Home</a>
          <a href="/blogs" class="block px-4 py-2 text-sm text-gray-200 hover:bg-gray-800">Blogs</a>
          <a href="/categories" class="block px-4 py-2 text-sm text-gray-200 hover:bg-gray-800">Categories</a>
          <a href="/tags" class="block px-4 py-2 text-sm text-gray-200 hover:bg-gray-800">Tags</a>
          <a href="/about" class="block px-4 py-2 text-sm text-gray-200 hover:bg-gray-800">About</a>
        </div>
      </div>
    </header>

    <main class="flex-1 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-12">
        <slot />
      </div>
    </main>

    <footer class="bg-gray-900 border-t border-gray-800 py-4 relative z-10">
      <p class="text-center font-sans text-xs text-green-400">© {new Date().getFullYear()} DEVDEBUG</p>
    </footer>
    
    <script>
      const navSearch = document.getElementById('nav-search') as HTMLInputElement | null;
      if (navSearch) {
        navSearch.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter') {
            const query = (navSearch.value || '').trim();
            window.location.href = query ? `/blogs?search=${encodeURIComponent(query)}` : '/blogs';
          }
        });
      }

      const mobileToggle = document.getElementById('mobile-menu-toggle') as HTMLElement | null;
      const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
      if (mobileToggle && mobileMenu) {
        mobileToggle.addEventListener('click', (e: MouseEvent) => {
          e.stopPropagation();
          mobileMenu.classList.toggle('hidden');
          const expanded = (!mobileMenu.classList.contains('hidden')).toString();
          mobileToggle.setAttribute('aria-expanded', expanded);
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', (e: Event) => {
          if (!mobileMenu.classList.contains('hidden')) {
            const target = e.target as Node | null;
            if (!mobileMenu.contains(target) && !mobileToggle.contains(target)) {
              mobileMenu.classList.add('hidden');
              mobileToggle.setAttribute('aria-expanded', 'false');
            }
          }
        });
      }
    </script>
  </body>
</html>



