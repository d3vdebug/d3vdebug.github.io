---
const { post } = Astro.props;

// Toggle dates visibility here
const SHOW_DATES = false;
---

<a href={`/blogs/${post.slug}`} class="block group">
  <article class="border border-gray-700 bg-gray-900/40 rounded-sm overflow-hidden hover:border-gray-600 transition-colors">
    {post.image && (
      <div class="aspect-video w-full overflow-hidden bg-gray-800">
        <img 
          src={post.image} 
          alt={post.title}
          class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
        />
      </div>
    )}
    
    <div class="p-4">
      <h2 class="text-lg font-semibold text-gray-100 mb-1.5 group-hover:text-green-400 transition-colors leading-snug">
        {post.title}
      </h2>
      
      <p class="text-gray-400 text-sm leading-relaxed mb-3 line-clamp-2">
        {post.description}
      </p>
      
      <div class="flex items-center justify-between gap-2">
        {post.category && (
          <span class="inline-flex items-center px-2.5 py-1 rounded-md border border-green-400/20 bg-green-400/10 text-xs font-medium text-green-400">
            {post.category}
          </span>
        )}
        {post.difficulty && (
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border ${
            post.difficulty === 'Easy' ? 'text-green-400 bg-green-400/10 border-green-400/20' :
            post.difficulty === 'Medium' ? 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20' :
            post.difficulty === 'Hard' ? 'text-red-400 bg-red-400/10 border-red-400/20' :
            'text-purple-400 bg-purple-400/10 border-purple-400/20'
          }`}>
            <i class="ph ph-chart-bar text-sm"></i>
            <span class="text-xs font-medium">{post.difficulty}</span>
          </span>
        )}
      </div>
    </div>
  </article>
</a>
