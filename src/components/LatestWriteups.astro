---
import { getCollection } from 'astro:content';

const { currentSlug } = Astro.props;

// Toggle dates visibility here
const SHOW_DATES = false;

const allPosts = (await getCollection('writeups'))
  .filter(post => !post.data.unlisted)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter(post => post.slug !== currentSlug)
  .slice(0, 3);
---

<section class="border-t border-gray-800 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="text-xl font-semibold text-gray-100 mb-8">Latest Blogs</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 justify-items-center">
      {allPosts.map(post => (
          <a href={`/blogs/${post.slug}`} class="block group w-full max-w-md sm:max-w-none">
          <article class="border border-gray-700 bg-gray-900/40 rounded-sm overflow-hidden hover:border-gray-600 transition-colors w-full">
            {post.data.image && (
              <div class="aspect-video w-full overflow-hidden bg-gray-800">
                <img 
                  src={post.data.image} 
                  alt={post.data.title}
                  class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                />
              </div>
            )}
            
            <div class="p-4">
              {SHOW_DATES && (
                <div class="flex items-center gap-3 text-xs text-gray-500 mb-2">
                  <span class="text-green-400 font-medium">{post.data.category}</span>
                  <span>•</span>
                  <time>{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                </div>
              )}
              
              <h3 class="text-lg font-semibold text-gray-100 mb-2 group-hover:text-green-400 transition-colors">
                {post.data.title}
              </h3>
              
              <p class="text-gray-400 text-sm leading-relaxed line-clamp-2">
                {post.data.description}
              </p>
              
              <div class="flex items-center justify-between gap-2 mt-4">
                {post.data.category && (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md border border-green-400/20 bg-green-400/10 text-xs font-medium text-green-400">
                    {post.data.category}
                  </span>
                )}
                {post.data.difficulty && (
                  <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border ${
                    post.data.difficulty === 'Easy' ? 'text-green-400 bg-green-400/10 border-green-400/20' :
                    post.data.difficulty === 'Medium' ? 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20' :
                    post.data.difficulty === 'Hard' ? 'text-red-400 bg-red-400/10 border-red-400/20' :
                    'text-purple-400 bg-purple-400/10 border-purple-400/20'
                  }`}>
                    <i class="ph ph-chart-bar text-sm"></i>
                    <span class="text-xs font-medium">{post.data.difficulty}</span>
                  </span>
                )}
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>
  </div>
</section>
